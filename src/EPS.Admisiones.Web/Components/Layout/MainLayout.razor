@inherits LayoutComponentBase

@* Portal institucional: encabezado con identidad, barra de navegacion
   horizontal pegajosa y pie con contexto tecnico del despliegue. *@

<header class="encabezado">
    <div class="encabezado__interior">
        <a class="logo" href="">
            <span class="logo__simbolo" aria-hidden="true">
                <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
                    <path d="M12 4v16M4 12h16" />
                </svg>
            </span>
            <span class="logo__texto">
                <span class="logo__nombre">EPS Salud Integral</span>
                <span class="logo__descriptor">Modulo de admisiones</span>
            </span>
        </a>

        <div class="encabezado__acciones">
            @* Sesion simulada: la autenticacion con Entra ID queda fuera del
               alcance de la PoC y esta documentada como pendiente en el README. *@
            <div class="usuario">
                <span class="usuario__avatar" aria-hidden="true">JP</span>
                <span class="usuario__datos">
                    <span class="usuario__nombre">Jenny Portilla</span>
                    <span class="usuario__rol">Auditoria medica</span>
                </span>
            </div>
        </div>
    </div>
</header>

<nav class="navbar" aria-label="Navegacion principal">
    <div class="navbar__interior">
        <NavLink class="navbar__enlace" href="" Match="NavLinkMatch.All">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            </svg>
            Inicio
        </NavLink>

        <NavLink class="navbar__enlace" href="admisiones/nueva">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14" />
            </svg>
            Registrar admision
        </NavLink>

        <NavLink class="navbar__enlace" href="admisiones">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 6h18M3 12h18M3 18h18" />
            </svg>
            Consultar admisiones
        </NavLink>

        <NavLink class="navbar__enlace" href="dashboard">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            </svg>
            Monitoreo en vivo
        </NavLink>

        <a class="navbar__enlace navbar__separador" href="/swagger" target="_blank" rel="noopener">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h6v6M10 14L21 3" />
                <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
            </svg>
            <span>API</span>
        </a>
    </div>
</nav>

<main class="contenido">
    @Body
</main>

<footer class="pie">
    <div class="pie__interior">
        <span>EPS Salud Integral &middot; Modulo de admisiones &middot; Prueba de concepto</span>
        <span>.NET 8 &middot; SQL Server + MongoDB &middot; Patron Outbox</span>
    </div>
</footer>
